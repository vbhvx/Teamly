# Environment Configuration Example
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/teamly_dev
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/teamly_test

# Authentication & Security
SESSION_SECRET=replace_with_a_64_character_secure_random_string_in_production
SESSION_EXPIRY_DAYS=7

# Rate Limiting (Requests per minute for auth/sensitive endpoints)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

